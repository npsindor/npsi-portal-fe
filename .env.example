# Copy to .env.local for local development.
# URL of the nps-be API. Use http://localhost:4000 when running the backend locally.
VITE_API_BASE_URL=http://localhost:4000

# Google reCAPTCHA v3 site key (optional; leave empty locally, the backend skips verification without a secret)
VITE_RECAPTCHA_SITE_KEY=
